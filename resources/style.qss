/* ============================================================
   Tokyo Twilight — Qt6 数据管理系统视觉样式
   色调约定:
     bg-base    #161821  窗口底色(深墨,微蓝调)
     bg-surface #1E2030  表面层(表格、输入框)
     bg-hover   #23253A  行 hover/选中
     border     #2A2C3D  发丝线
     text       #E9E5D8  主文(暖白)
     muted      #7A7D8B  次级文本
     header     #D4A574  表头柔金
     accent     #FF6B5C  暖珊瑚强调
     press      #E55549  按下态
   ============================================================ */

QMainWindow,
QWidget#centralWidget {
    background-color: #161821;
}

/* ---------- 标题 ---------- */
QLabel#headerTitle {
    color: #E9E5D8;
    font-family: "Source Han Serif SC", "Noto Serif SC", "SimSun", serif;
    font-size: 22pt;
    font-weight: 600;
    padding: 0;
    background: transparent;
}

QLabel#headerSubtle {
    color: #7A7D8B;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 9pt;
    letter-spacing: 4px;
    background: transparent;
}

QFrame#headerRule {
    background-color: #FF6B5C;
    border: none;
}

/* ---------- 表格 ---------- */
QTableWidget {
    background-color: #1E2030;
    alternate-background-color: #1E2030;
    border: 1px solid #2A2C3D;
    border-radius: 8px;
    color: #E9E5D8;
    font-family: "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 10pt;
    gridline-color: #2A2C3D;
    selection-background-color: #23253A;
    selection-color: #E9E5D8;
    padding: 4px;
}

QTableWidget::item {
    padding: 8px 12px;
    border-left: 3px solid transparent;
    border-bottom: 1px solid #2A2C3D;
}

QTableWidget::item:hover {
    background-color: #23253A;
    border-left: 3px solid #FF6B5C;
}

QTableWidget::item:selected {
    background-color: #23253A;
    color: #E9E5D8;
    border-left: 3px solid #FF6B5C;
}

QHeaderView::section {
    background-color: #191B27;
    color: #D4A574;
    font-family: "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 9pt;
    font-weight: 600;
    padding: 12px 12px;
    border: none;
    border-bottom: 1px solid #2A2C3D;
}

QHeaderView::section:first {
    border-top-left-radius: 6px;
}

QHeaderView::section:last {
    border-top-right-radius: 6px;
}

QTableCornerButton::section {
    background-color: #191B27;
    border: none;
    border-bottom: 1px solid #2A2C3D;
}

/* 竖向行号(行头) */
QTableView QHeaderView::section:vertical {
    background-color: #191B27;
    color: #7A7D8B;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 9pt;
    padding: 0 12px;
    border-right: 1px solid #2A2C3D;
}

/* ---------- 输入框 (QPlainTextEdit) ---------- */
QPlainTextEdit#sqlInput {
    background-color: #1E2030;
    color: #E9E5D8;
    border: 1px solid #2A2C3D;
    border-radius: 6px;
    padding: 8px 14px;
    font-family: "JetBrains Mono", "Consolas", "Cascadia Mono", monospace;
    font-size: 11pt;
    selection-background-color: #FF6B5C;
    selection-color: #161821;
}

QPlainTextEdit#sqlInput:focus {
    border: 1px solid #FF6B5C;
}

/* ---------- 分页栏 ---------- */
QWidget#paginationBar {
    background-color: transparent;
    border-top: 1px solid #2A2C3D;
}

QPushButton#pageButton {
    background-color: #1E2030;
    color: #E9E5D8;
    border: 1px solid #2A2C3D;
    border-radius: 6px;
    padding: 6px 16px;
    font-family: "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 10pt;
    font-weight: 500;
    min-height: 28px;
    min-width: 88px;
}

QPushButton#pageButton:hover {
    background-color: #23253A;
    border-color: #FF6B5C;
    color: #FF6B5C;
}

QPushButton#pageButton:pressed {
    background-color: #2A2C3D;
}

QPushButton#pageButton:disabled {
    background-color: #1A1C28;
    color: #4A4D5E;
    border-color: #2A2C3D;
}

QLabel#pageLabel {
    color: #D4A574;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 10pt;
    background: transparent;
    padding: 0 12px;
}

/* ---------- Schema 面板 ---------- */
QTreeWidget#schemaTree {
    background-color: #191B27;
    border: none;
    border-right: 1px solid #2A2C3D;
    color: #E9E5D8;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 9pt;
    padding: 8px 0;
    outline: 0;
}

QTreeWidget#schemaTree::item {
    padding: 3px 10px;
    border: none;
}

QTreeWidget#schemaTree::item:hover {
    background-color: #23253A;
    border-radius: 3px;
}

QTreeWidget#schemaTree::item:selected {
    background-color: #23253A;
    color: #E9E5D8;
}

/* Splitter handle */
QSplitter::handle:horizontal {
    background-color: #2A2C3D;
    width: 1px;
}

/* ---------- 空状态 ---------- */
QWidget#emptyState {
    background-color: #161821;
}

QLabel#emptyStateSvg {
    background: transparent;
}

QLabel#emptyStateMsg {
    color: #7A7D8B;
    background: transparent;
    font-family: "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 11pt;
    letter-spacing: 1.5px;
    padding: 0 32px;
}

/* ---------- 按钮 ---------- */
QPushButton#runButton {
    background-color: #FF6B5C;
    color: #161821;
    border: none;
    border-radius: 6px;
    padding: 0 24px;
    font-family: "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 11pt;
    font-weight: 600;
    min-height: 48px;
    min-width: 92px;
}

QPushButton#runButton:hover {
    background-color: #FF7E70;
}

QPushButton#runButton:pressed {
    background-color: #E55549;
    padding-top: 1px;
}

QPushButton#runButton:disabled {
    background-color: #2A2C3D;
    color: #7A7D8B;
}

/* ---------- 状态栏 ---------- */
QStatusBar {
    background-color: #161821;
    color: #7A7D8B;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 9pt;
    border-top: 1px solid #2A2C3D;
}

QStatusBar::item {
    border: none;
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #2A2C3D;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #3A3D52;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #2A2C3D;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #3A3D52;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---------- 对话框 ---------- */
QMessageBox {
    background-color: #1E2030;
    color: #E9E5D8;
    font-family: "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
}

QMessageBox QLabel {
    color: #E9E5D8;
    font-size: 10pt;
}

QMessageBox QPushButton {
    background-color: #FF6B5C;
    color: #161821;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-weight: 600;
    min-width: 72px;
}

QMessageBox QPushButton:hover {
    background-color: #FF7E70;
}

QMessageBox QPushButton:pressed {
    background-color: #E55549;
}

/* tooltip */
QToolTip {
    background-color: #1E2030;
    color: #E9E5D8;
    border: 1px solid #2A2C3D;
    padding: 6px 10px;
    font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
    font-size: 9pt;
}
