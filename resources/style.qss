/* ============================================================
   Slate Dawn — Qt6 数据管理系统视觉样式
   色调约定:
     bg-base    #F0F2F7  窗口底色(浅灰)
     bg-surface #FFFFFF  表面层(表格、输入框)
     bg-hover   #E8EAFF  行 hover/选中(浅靛蓝)
     border     #DDE1EC  发丝线
     text       #1C2033  主文(深海军蓝)
     muted      #8B90A8  次级文本
     header     #4451D4  靛蓝标签(对比度优化,≥4.5:1)
     accent     #5B6CF4  靛蓝强调(交互元素)
     press      #4451D4  按下态
     disabled   #E8EAF0 / #B0B4CC  禁用按钮背景/文字
   ============================================================ */

QMainWindow,
QWidget#centralWidget {
    background-color: #F0F2F7;
}

/* ---------- 标题 ---------- */
QLabel#headerTitle {
    color: #1C2033;
    font-family: "Source Han Serif SC", "Noto Serif SC", "SimSun", serif;
    font-size: 22pt;
    font-weight: 600;
    padding: 0;
    background: transparent;
}

QLabel#headerSubtle {
    color: #8B90A8;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 9pt;
    letter-spacing: 4px;
    background: transparent;
}

QFrame#headerRule {
    background-color: #5B6CF4;
    border: none;
}

/* ---------- 表格 ---------- */
QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #FFFFFF;
    border: 1px solid #DDE1EC;
    border-radius: 8px;
    color: #1C2033;
    font-family: "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 10pt;
    gridline-color: #DDE1EC;
    selection-background-color: #E8EAFF;
    selection-color: #1C2033;
    padding: 4px;
}

QTableWidget::item {
    padding: 8px 12px;
    border-left: 3px solid transparent;
    border-bottom: 1px solid #DDE1EC;
}

QTableWidget::item:hover {
    background-color: #E8EAFF;
    border-left: 3px solid #5B6CF4;
}

QTableWidget::item:selected {
    background-color: #E8EAFF;
    color: #1C2033;
    border-left: 3px solid #5B6CF4;
}

QHeaderView::section {
    background-color: #F0F2F7;
    color: #4451D4;
    font-family: "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 9pt;
    font-weight: 600;
    padding: 12px 12px;
    border: none;
    border-bottom: 1px solid #DDE1EC;
}

QHeaderView::section:first {
    border-top-left-radius: 6px;
}

QHeaderView::section:last {
    border-top-right-radius: 6px;
}

QTableCornerButton::section {
    background-color: #F0F2F7;
    border: none;
    border-bottom: 1px solid #DDE1EC;
}

/* 竖向行号(行头) */
QTableView QHeaderView::section:vertical {
    background-color: #F0F2F7;
    color: #8B90A8;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 9pt;
    padding: 0 12px;
    border-right: 1px solid #DDE1EC;
}

/* ---------- 输入框 (QPlainTextEdit) ---------- */
QPlainTextEdit#sqlInput {
    background-color: #FFFFFF;
    color: #1C2033;
    border: 1px solid #DDE1EC;
    border-radius: 6px;
    padding: 8px 14px;
    font-family: "JetBrains Mono", "Consolas", "Cascadia Mono", monospace;
    font-size: 11pt;
    selection-background-color: #5B6CF4;
    selection-color: #FFFFFF;
}

QPlainTextEdit#sqlInput:focus {
    border: 1px solid #5B6CF4;
}

/* ---------- 分页栏 ---------- */
QWidget#paginationBar {
    background-color: transparent;
    border-top: 1px solid #DDE1EC;
}

QPushButton#pageButton {
    background-color: #FFFFFF;
    color: #1C2033;
    border: 1px solid #DDE1EC;
    border-radius: 6px;
    padding: 6px 16px;
    font-family: "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 10pt;
    font-weight: 500;
    min-height: 28px;
    min-width: 88px;
}

QPushButton#pageButton:hover {
    background-color: #E8EAFF;
    border-color: #5B6CF4;
    color: #5B6CF4;
}

QPushButton#pageButton:pressed {
    background-color: #DDE1EC;
}

QPushButton#pageButton:disabled {
    background-color: #E8EAF0;
    color: #B0B4CC;
    border-color: #DDE1EC;
}

QLabel#pageLabel {
    color: #4451D4;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 10pt;
    background: transparent;
    padding: 0 12px;
}

/* ---------- 分页跳转输入框 ---------- */
QFrame#pageJumpDivider {
    color: #DDE1EC;
    max-width: 1px;
}

QLineEdit#pageJumpEdit {
    background-color: #FFFFFF;
    color: #1C2033;
    border: 1px solid #DDE1EC;
    border-radius: 6px;
    padding: 4px 6px;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 10pt;
    selection-background-color: #5B6CF4;
    selection-color: #FFFFFF;
}

QLineEdit#pageJumpEdit:focus {
    border: 1px solid #5B6CF4;
}

/* ---------- Schema 面板 ---------- */
QTreeWidget#schemaTree {
    background-color: #F0F2F7;
    border: none;
    border-right: 1px solid #DDE1EC;
    color: #1C2033;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 9pt;
    padding: 8px 0;
    outline: 0;
}

QTreeWidget#schemaTree::item {
    padding: 3px 10px;
    border: none;
}

QTreeWidget#schemaTree::item:hover {
    background-color: #E8EAFF;
    border-radius: 3px;
}

QTreeWidget#schemaTree::item:selected {
    background-color: #E8EAFF;
    color: #1C2033;
}

/* Splitter handle */
QSplitter::handle:horizontal {
    background-color: #DDE1EC;
    width: 1px;
}

/* ---------- 空状态 ---------- */
QWidget#emptyState {
    background-color: #F0F2F7;
}

QLabel#emptyStateSvg {
    background: transparent;
}

QLabel#emptyStateMsg {
    color: #8B90A8;
    background: transparent;
    font-family: "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 11pt;
    letter-spacing: 1.5px;
    padding: 0 32px;
}

/* ---------- 按钮 ---------- */
QPushButton#runButton {
    background-color: #5B6CF4;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 0 24px;
    font-family: "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 11pt;
    font-weight: 600;
    min-height: 48px;
    min-width: 92px;
}

QPushButton#runButton:hover {
    background-color: #7280F6;
}

QPushButton#runButton:pressed {
    background-color: #4451D4;
    padding-top: 1px;
}

QPushButton#runButton:disabled {
    background-color: #DDE1EC;
    color: #8B90A8;
}

/* ---------- 状态栏 ---------- */
QStatusBar {
    background-color: #F0F2F7;
    color: #8B90A8;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 9pt;
    border-top: 1px solid #DDE1EC;
}

QStatusBar::item {
    border: none;
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #C8CCE0;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #A8AECE;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #C8CCE0;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #A8AECE;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---------- 对话框 ---------- */
QMessageBox {
    background-color: #FFFFFF;
    color: #1C2033;
    font-family: "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
}

QMessageBox QLabel {
    color: #1C2033;
    font-size: 10pt;
}

QMessageBox QPushButton {
    background-color: #5B6CF4;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-weight: 600;
    min-width: 72px;
}

QMessageBox QPushButton:hover {
    background-color: #7280F6;
}

QMessageBox QPushButton:pressed {
    background-color: #4451D4;
}

/* tooltip */
QToolTip {
    background-color: #FFFFFF;
    color: #1C2033;
    border: 1px solid #DDE1EC;
    padding: 6px 10px;
    font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
    font-size: 9pt;
}
